# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (docker compose up -d db gives you this one)
DATABASE_URL="postgresql://kumbara:kumbara@localhost:5432/kumbara?schema=public"

# Session signing secret, at least 32 characters: openssl rand -base64 32
AUTH_SECRET=""

# First Admin account, created by `npm run db:seed` (password: 12+ characters)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Currencies: rates are stored against BASE_CURRENCY, totals shown in HOME_CURRENCY
BASE_CURRENCY="USD"
HOME_CURRENCY="TRY"

# Exchange-rate provider (European Central Bank rates, no key needed)
RATES_API_URL="https://api.frankfurter.app"

# Protects the daily rates job at /api/cron/rates (32+ characters: openssl rand -base64 32).
# Leave empty to turn the endpoint off and run `npm run rates:sync` from a scheduler instead.
CRON_SECRET=""

# Receipts are stored on local disk in this folder (created on first upload)
RECEIPTS_DIR="storage/receipts"

# S3-compatible storage for receipts (not used yet; local disk for now)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
